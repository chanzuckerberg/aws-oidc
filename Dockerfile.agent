FROM 533267185808.dkr.ecr.us-west-2.amazonaws.com/docker.io/central/library/debian:bookworm-slim

ARG CLAUDE_CODE_VERSION=2.1.251
ARG GH_CLI_VERSION=2.98.0
ARG HELM_VERSION=4.2.4
ARG KUBECTL_VERSION=1.37.0
ARG TERRAFORM_VERSION=1.16.1
ARG YQ_VERSION=4.53.6
ARG ARGUS_VERSION=0.139.2
ARG FOGG_VERSION=0.92.54
ARG GO_VERSION=1.27.1
ARG NODE_VERSION=24.20.0
ARG TARGETARCH

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        dnsutils \
        file \
        findutils \
        git \
        gnupg \
        grep \
        gzip \
        iputils-ping \
        jq \
        less \
        make \
        net-tools \
        openssh-client \
        openssl \
        patch \
        procps \
        postgresql-client \
        python3 \
        python3-pip \
        python3-venv \
        redis-tools \
        ripgrep \
        rsync \
        sed \
        tar \
        tree \
        unzip \
        vim-tiny \
        wget \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Install Tailscale so the entrypoint can enroll the pod in the tailnet when
# TAILSCALE_TOKEN_FILE is set. Uses userspace-networking so no TUN device or
# elevated privileges are needed.
RUN curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.noarmor.gpg \
        -o /usr/share/keyrings/tailscale-archive-keyring.gpg \
    && curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.tailscale-keyring.list \
        -o /etc/apt/sources.list.d/tailscale.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends tailscale \
    && rm -rf /var/lib/apt/lists/*  

# Install AWS CLI v2 — architecture-aware to support both amd64 and arm64 nodes.
RUN case "${TARGETARCH}" in \
        amd64) AWS_ARCH=x86_64 ;; \
        arm64) AWS_ARCH=aarch64 ;; \
        *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${AWS_ARCH}.zip" -o /tmp/awscliv2.zip \
    && unzip -q /tmp/awscliv2.zip -d /tmp \
    && /tmp/aws/install \
    && rm -rf /tmp/awscliv2.zip /tmp/aws \
    && aws --version

# Install Go.
RUN case "${TARGETARCH}" in \
        amd64) GO_ARCH=amd64 ;; \
        arm64) GO_ARCH=arm64 ;; \
        *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://golang.org/dl/go${GO_VERSION}.linux-${GO_ARCH}.tar.gz" -o /tmp/go.tar.gz \
    && tar -xzf /tmp/go.tar.gz -C /usr/local \
    && rm -f /tmp/go.tar.gz \
    && ln -sf /usr/local/go/bin/go /usr/local/bin/go \
    && go version

# Install Node.js (includes npm).
RUN case "${TARGETARCH}" in \
        amd64) NODE_ARCH=x64 ;; \
        arm64) NODE_ARCH=arm64 ;; \
        *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
        -o /tmp/node.tar.xz \
    && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
    && rm -f /tmp/node.tar.xz \
    && node --version && npm --version

# Install helm.
RUN curl -fsSL "https://get.helm.sh/helm-v${HELM_VERSION}-linux-${TARGETARCH}.tar.gz" -o /tmp/helm.tar.gz \
    && tar -xzf /tmp/helm.tar.gz -C /tmp \
    && mv /tmp/linux-${TARGETARCH}/helm /usr/local/bin/helm \
    && rm -rf /tmp/helm.tar.gz /tmp/linux-${TARGETARCH} \
    && helm version

# Install kubectl.
RUN curl -fsSL "https://dl.k8s.io/release/v${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl" \
        -o /usr/local/bin/kubectl \
    && chmod +x /usr/local/bin/kubectl \
    && kubectl version --client

# Install Terraform.
RUN case "${TARGETARCH}" in \
        amd64) TF_ARCH=amd64 ;; \
        arm64) TF_ARCH=arm64 ;; \
        *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_${TF_ARCH}.zip" \
        -o /tmp/terraform.zip \
    && unzip -q /tmp/terraform.zip -d /usr/local/bin \
    && rm -f /tmp/terraform.zip \
    && terraform version

# Install yq.
RUN case "${TARGETARCH}" in \
        amd64) YQ_ARCH=amd64 ;; \
        arm64) YQ_ARCH=arm64 ;; \
        *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/mikefarah/yq/releases/download/v${YQ_VERSION}/yq_linux_${YQ_ARCH}" \
        -o /usr/local/bin/yq \
    && chmod +x /usr/local/bin/yq \
    && yq --version

# Install argus.
RUN case "${TARGETARCH}" in \
        amd64) ARGUS_ARCH=amd64 ;; \
        arm64) ARGUS_ARCH=arm64 ;; \
        *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/chanzuckerberg/argus-artifacts/releases/download/v${ARGUS_VERSION}/argus_${ARGUS_VERSION}_linux_${ARGUS_ARCH}.tar.gz" \
        -o /tmp/argus.tar.gz \
    && tar -xzf /tmp/argus.tar.gz -C /usr/local/bin argus \
    && rm -f /tmp/argus.tar.gz \
    && argus version

# Install fogg.
RUN case "${TARGETARCH}" in \
        amd64) FOGG_ARCH=amd64 ;; \
        arm64) FOGG_ARCH=arm64 ;; \
        *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/chanzuckerberg/fogg/releases/download/v${FOGG_VERSION}/fogg_${FOGG_VERSION}_linux_${FOGG_ARCH}.tar.gz" \
        -o /tmp/fogg.tar.gz \
    && tar -xzf /tmp/fogg.tar.gz -C /usr/local/bin fogg \
    && rm -f /tmp/fogg.tar.gz \
    && fogg version

# Install awscurl and expose pip as an alias for pip3.
RUN pip3 install --break-system-packages awscurl \
    && ln -sf "$(which pip3)" /usr/local/bin/pip

# Install Claude Code CLI from the official release location.
RUN case "${TARGETARCH}" in \
        amd64) CLAUDE_ARCH=linux-x64 ;; \
        arm64) CLAUDE_ARCH=linux-arm64 ;; \
        *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://downloads.claude.ai/claude-code-releases/${CLAUDE_CODE_VERSION}/${CLAUDE_ARCH}/claude" \
        -o /usr/local/bin/claude \
    && chmod +x /usr/local/bin/claude \
    && claude --version

# Install the GitHub CLI, which the agent uses to open and review pull requests.
RUN curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_CLI_VERSION}/gh_${GH_CLI_VERSION}_linux_${TARGETARCH}.tar.gz" \
        -o /tmp/gh.tar.gz \
    && mkdir -p /usr/local/lib/gh \
    && tar -xzf /tmp/gh.tar.gz -C /usr/local/lib/gh --strip-components=1 \
    && rm -f /tmp/gh.tar.gz

# Mint an installation access token per call, so neither git nor gh ever holds a stale one.
COPY docker/agent/github-app-token.sh /usr/local/bin/github-app-token
COPY docker/agent/git-credential-github-app.sh /usr/local/bin/git-credential-github-app
COPY docker/agent/gh.sh /usr/local/bin/gh
RUN chmod 0755 /usr/local/bin/github-app-token /usr/local/bin/git-credential-github-app /usr/local/bin/gh \
    && gh --version

# Git identity required for any commit a session makes.
RUN git config --system user.name "Claude" \
    && git config --system user.email "noreply@anthropic.com" \
    && git config --system --add safe.directory '*' \
    && git config --system credential.https://github.com.helper github-app \
    && git config --system credential.https://github.com.useHttpPath true

# Create a non-root user matching the pod security context (runAsUser: 1000).
RUN groupadd --gid 1000 agent \
    && useradd --uid 1000 --gid 1000 --no-create-home --home-dir /workspace --shell /bin/bash agent \
    && mkdir -p /var/run/tailscale \
    && chown agent:agent /var/run/tailscale

# Containers never auto-update; disable the background check so sessions don't
# waste time or network on it.
ENV DISABLE_AUTOUPDATER=1

COPY docker/agent/entrypoint.sh /usr/local/bin/agent-entrypoint
RUN chmod 0755 /usr/local/bin/agent-entrypoint

WORKDIR /workspace
USER agent

ENTRYPOINT ["agent-entrypoint"]
